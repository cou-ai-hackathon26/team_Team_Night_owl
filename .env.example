# ScamShield BD Environment Variables Template
NODE_ENV=development
PORT=3000

# Database (Neon PostgreSQL with pgvector)
DATABASE_URL=your_database_url

# Google Gemini API
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash
LLM_FALLBACK_MODEL=gemini-1.5-flash
VISION_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIM=768

# Google Safe Browsing Lookup API (v4)
SAFE_BROWSING_API_KEY=xyz

# Security & Community
REPORTER_HASH_SECRET=replace_with_a_secure_random_32_byte_string
REPORT_ACCEPT_MIN_REPORTERS=2

# Rate Limits
RATE_LIMIT_ANALYZE_PER_MIN=20
RATE_LIMIT_REPORT_PER_HOUR=5
