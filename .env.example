# ScamShield BD Environment Variables Template
# Spec Section 1.3 Rule 3: Commit .env.example with empty values only.
NODE_ENV=
PORT=

# Database
DATABASE_URL=

# Google Gemini API
GEMINI_API_KEY=
LLM_MODEL=
LLM_FALLBACK_MODEL=
VISION_MODEL=
EMBEDDING_MODEL=
EMBEDDING_DIM=

# Google Safe Browsing Lookup API (v4)
SAFE_BROWSING_API_KEY=

# Security & Community
REPORTER_HASH_SECRET=
REPORT_ACCEPT_MIN_REPORTERS=

# Rate Limits
RATE_LIMIT_ANALYZE_PER_MIN=
RATE_LIMIT_REPORT_PER_HOUR=
